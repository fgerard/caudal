# La pone docker/Dockerfile al construir la imagen, con la version de project.clj (unica fuente
# de verdad): el instance.env que extrae bootstrap.sh trae la version de la imagen de la que salio.
VERSION=
IMAGE_NAME=caudal
# Tiene que ser unico en el host: puede haber varias instancias de caudal en el mismo servidor,
# cada una con su propio data/ y su propio instance.env.
CONTAINER_NAME=caudal
TARGET_USER=quantum
TARGET_GROUP=quantum
TZ=America/Mexico_City
MINIMUM_MEMORY=1G
MAXIMUM_MEMORY=2G
# Puertos que publica el contenedor, separados por comas: los que declaran los listeners de
# config/main.clj (TCP, REST, syslog...). Mismo numero en host y contenedor, asi que tampoco
# pueden repetirse entre instancias del mismo host. Para UDP: 514/udp.
PORTS=7777,8099,8080
# Puerto HTTP (REST/dashboard) que prueba bin/health-check.sh. Vacio = solo revisa que el
# contenedor este corriendo.
HTTP_PORT=8099
# Red de docker a la que se conecta el contenedor. Vacio = la red por omision de docker.
# quantum-network (la de qface-server) permite llegar a otros contenedores por su nombre, ej.
# http://qface-server:8000, aunque solo esten publicados en 127.0.0.1.
NETWORK=
# IPs adicionales del host donde se publican los PORTS; 127.0.0.1 siempre esta incluida.
# Vacio o ausente = solo loopback. Si no, IPs separadas por comas (ej. la IP de ZeroTier
# de este host: 10.147.20.5,192.168.1.10). Tienen que ser IPs literales, no nombres:
# docker rechaza cualquier cosa que no parsee como IP.
# 0.0.0.0 es valido y expone los puertos en TODAS las interfaces, incluida la publica. ufw no
# filtra puertos publicados por docker, asi que ponerlo aqui los deja abiertos a internet.
BIND_EXTRA_IPS=
