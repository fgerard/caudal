
# Parametros de esta instancia. VERSION e IMAGE_NAME los actualiza
# docker/create-data-dir.sh (lee el nombre del directorio de build, ej.
# caudal-0.9.1, que a su vez sale de project.clj via bin/make-distro.sh --
# unica fuente de verdad para la version) en cada generacion; el resto se
# edita a mano aqui, una sola vez por instancia/cliente, y start.sh los lee
# con `source` para no tener que hardcodearlos.
VERSION=0.0.0
IMAGE_NAME=caudal
CONTAINER_NAME=caudal-TEMPLATE
TIMEZONE=America/Mexico_City
MINIMUM_MEMORY=1G
MAXIMUM_MEMORY=2G
# Puertos que expone esta plantilla (definidos en main.clj: listener TCP y
# listener REST). Cada config-<sufijo>/main.clj puede declarar puertos
# distintos -- ajustar aqui para que coincidan.
TCP_PORT=7777
HTTP_PORT=8099
# IPs adicionales del host donde se publican TCP_PORT/HTTP_PORT; 127.0.0.1
# siempre esta incluida. Vacio o ausente = solo loopback. Si no, IPs
# separadas por comas. Tienen que ser IPs literales, no nombres: docker
# rechaza cualquier cosa que no parsee como IP.
# 0.0.0.0 es valido y expone la API en TODAS las interfaces, incluida la
# publica. ufw no filtra puertos publicados por docker, asi que ponerlo
# aqui deja la API abierta a internet.
BIND_EXTRA_IPS=
